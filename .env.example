# ---- TiDB Cloud (Starter, region AWS ap-southeast-1 Singapore แนะนำ) ----
# Connect → General → เลือก "Node.js / mysql2" แล้วคัดลอก host, user (มี prefix เช่น 4abc123.root), password
DATABASE_URL=mysql://4abc123.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ptc_schedule
DB_SSL=true
# เปิดเมื่อใช้ TiDB Cloud Starter บน AWS (EMBED_TEXT / Vector Search ฟรีในตัว ใช้กับหน้าถาม AI)
TIDB_AUTO_EMBEDDING=true
# สร้าง TiFlash replica ให้ students, timetable (ใช้กับรายงาน/ส่งออก)
TIDB_TIFLASH=true


# ---- Session (สุ่มยาว ≥ 32 ตัว: openssl rand -base64 48) ----
SESSION_SECRET=


# ---- ผู้ช่วย AI: Google Gemini (ฟรี) อ่านผลค้นจาก TiDB แล้วเรียบเรียงคำตอบ · ไม่ใส่ = แสดงผลค้นหาอย่างเดียว ----
# สร้าง key ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# ---- Email OTP (เช่น Brevo: Settings → SMTP & API) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxxx001@smtp-brevo.com
SMTP_PASS=brevo-smtp-key
SMTP_FROM=PTC <verified-sender@example.com>

# ชั่วคราว: ชื่อผู้ใช้ที่ข้าม OTP (คั่นด้วย ,) — ลบออกก่อนใช้งานจริง
# SKIP_OTP_USERNAMES=admin

# ---- ภาคเรียนปัจจุบัน ----
ACADEMIC_YEAR=2569
SEMESTER=1

# ---- ใช้ตอน seed เท่านั้น: อีเมลรับ OTP ของบัญชีทดสอบ ----
SEED_ADMIN_EMAIL=
SEED_TEACHER_EMAIL=
