# ---- TiDB Cloud (Starter, region AWS ap-southeast-1 Singapore แนะนำ) ----
# Connect → General → เลือก "Node.js / mysql2" แล้วคัดลอก host, user (มี prefix เช่น 4abc123.root), password
DATABASE_URL=mysql://4abc123.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ptc_schedule
DB_SSL=true
# เปิดเมื่อใช้ TiDB Cloud Starter บน AWS (EMBED_TEXT / Vector Search ฟรีในตัว)
TIDB_AUTO_EMBEDDING=true
# สร้าง TiFlash replica ให้ students, timetable (ใช้กับรายงาน/ส่งออก)
TIDB_TIFLASH=true

# บัญชีอ่านอย่างเดียวสำหรับ AI Text-to-SQL (ไม่บังคับ แต่แนะนำ)
# migrate จะสร้าง user นี้ให้ — บน TiDB Cloud ชื่อต้องขึ้นต้นด้วย prefix เดียวกับ root
READONLY_DB_USER=4abc123.ptc_readonly
READONLY_DB_PASSWORD=change-me-strong-password
DATABASE_READONLY_URL=mysql://4abc123.ptc_readonly:change-me-strong-password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ptc_schedule

# ---- Session (สุ่มยาว ≥ 32 ตัว: openssl rand -base64 48) ----
SESSION_SECRET=

# ---- Claude API ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Email OTP (Gmail: เปิด 2-Step Verification แล้วสร้าง App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=app-password-16-chars
SMTP_FROM=PTC Smart Schedule <yourname@gmail.com>

# ---- ภาคเรียนปัจจุบัน ----
ACADEMIC_YEAR=2569
SEMESTER=1

# ---- ใช้ตอน seed เท่านั้น: อีเมลรับ OTP ของบัญชีทดสอบ ----
SEED_ADMIN_EMAIL=
SEED_TEACHER_EMAIL=
